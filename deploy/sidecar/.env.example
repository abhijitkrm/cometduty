# cometduty sidecar — copy to .env and fill in.

CHAIN_NAME=mychain
CHAIN_ID=mychain-1
VALIDATOR=my-validator                 # the validator's moniker
VALOPER=cosmosvaloper1...              # its operator address
NODE_HOME=/path/to/node/home           # host path of the node home (mounted read-only)

# Where the node publishes its ports on this host (defaults shown).
# NODE_RPC=http://127.0.0.1:26657
# NODE_EVM=http://127.0.0.1:8545
# NODE_METRICS=http://127.0.0.1:26660
# METRICS_PORT=28686                   # this sidecar's /metrics

# Log alerts: the node's container name, then start with --profile logs.
# LOGS_ENABLED=yes
# NODE_CONTAINER=mychain-1-validator

# Optional: send alerts to any webhook receiver, signed with a shared secret
# (docs/WEBHOOK.md).
# WEBHOOK_ENABLED=yes
# WEBHOOK_URL=https://hooks.example.com/cometduty
# WEBHOOK_SECRET=<openssl rand -hex 32>

# Optional: the silence API (Alertmanager v2 compatible), 16+ characters.
# API_TOKEN=<openssl rand -hex 32>

# COMETDUTY_IMAGE=cometduty:local      # a locally built image
