# cometduty sidecar overlay — copy to .env and fill in.
#
# VAL{N}_HOME: the host directory mounted into validator N's container as its
# evmd home (PRIMIUM_HOST_HOME in the primium setup scripts). Read-only for us.
# VAL{N}_OPER: the validator operator address (cosmosvaloper1... on primium) — get it with:
#   docker exec primium-validator0 evmd --home /data/node0/evmd \
#     keys show <key-name> --bech val -a --keyring-backend test

VAL0_HOME=/path/to/validator0/evmd
VAL0_OPER=cosmosvaloper1...
VAL1_HOME=/path/to/validator1/evmd
VAL1_OPER=cosmosvaloper1...
VAL2_HOME=/path/to/validator2/evmd
VAL2_OPER=cosmosvaloper1...
VAL3_HOME=/path/to/validator3/evmd
VAL3_OPER=cosmosvaloper1...
# COMETDUTY_IMAGE=cometduty:local   # uncomment to use a locally built image
