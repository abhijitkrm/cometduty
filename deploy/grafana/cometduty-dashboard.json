    {
      "type": "table",
      "title": "Validator Overview",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "expr": "cometduty_consecutive_missed_blocks{moniker=~\"$validator\"}",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "cometduty_window_missed_percent{moniker=~\"$validator\"}",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "cometduty_missed_blocks_for_window{moniker=~\"$validator\"}",
          "refId": "C",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "chain_id": true,
              "name": true,
              "job": true,
              "instance": true,
              "__name__": true
            },
            "renameByName": {
              "moniker": "validator",
              "validator": "valcons",
              "Value #A": "consecutive missed",
              "Value #B": "window missed %",
              "Value #C": "missed in window"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "consecutive missed"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 5
                    },
                    {
                      "color": "red",
                      "value": 20
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "consecutive missed",
            "desc": true
          }
        ]
      }
    },
