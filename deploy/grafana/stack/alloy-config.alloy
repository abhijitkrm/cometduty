// Grafana Alloy — reads every docker container's logs via the engine socket
// and pushes them to Loki, labeled by container name. Restrict the keep rule
// to your validators (e.g. regex = "primium-.*") if the host runs other
// workloads.

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	// container name without the leading slash → `container` label
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
	rule {
		source_labels = ["__meta_docker_container_id"]
		target_label  = "container_id"
	}
	// uncomment to tail only the validators:
	// rule {
	// 	source_labels = ["__meta_docker_container_name"]
	// 	regex         = "/primium-.*"
	// 	action        = "keep"
	// }
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.relabel.containers.output
	forward_to    = [loki.write.local.receiver]
	relabel_rules = discovery.relabel.containers.rules
	labels        = { job = "docker-containers" }
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
